<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Bridget</RootNamespace>
    <AssemblyName>Bridget</AssemblyName>
    <ApplicationIcon>Assets\Bridget.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>Bridget</Product>
    <Description>Your personal sales assistant: pauses music on calls, takes your notes, pastes your texts, answers when you ask.</Description>
    <Company>Bridget</Company>
    <Copyright>© 2026 Bridget</Copyright>
    <Version>6.1.0</Version>
    <FileVersion>6.1.0.0</FileVersion>
    <AssemblyVersion>6.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon/Screen; keep its global
         usings out so they can't collide with the WPF namespaces. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio.Wasapi (not the metapackage) is pure managed — single-file safe. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- The runtime package ships its natives as loose content files that a
         single-file publish would drop next to the exe; exclude its targets
         and embed the DLLs instead — WhisperRuntime extracts and loads them. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)\build\win-x64\*.dll"
                      LogicalName="Bridget.WhisperNative.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
