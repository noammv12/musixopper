<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.18362.0</TargetPlatformMinVersion>
    <!-- The app has no XAML, so WPF is only a framework reference. On
         non-Windows (compile checks on Linux agents) UseWPF would drag in
         the WindowsDesktop SDK import that distro dotnet packages don't
         ship — reference the framework directly there instead. -->
    <UseWPF Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWPF>
    <UseWindowsForms Condition="$([MSBuild]::IsOSPlatform('Windows'))">true</UseWindowsForms>
    <RootNamespace>Palon</RootNamespace>
    <AssemblyName>Palon</AssemblyName>
    <ApplicationIcon>Assets\Palon.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Product>Palon.AI</Product>
    <Description>Palon.AI — your personal sales aide: pauses music on calls, takes your notes, runs your commands, and answers when you ask.</Description>
    <Company>Palon.AI</Company>
    <Copyright>© 2026 Palon.AI</Copyright>
    <Version>8.1.0</Version>
    <FileVersion>8.1.0.0</FileVersion>
    <AssemblyVersion>8.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is referenced only for NotifyIcon/Screen; keep its global
         usings out so they can't collide with the WPF namespaces. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="!$([MSBuild]::IsOSPlatform('Windows'))">
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Palon.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- NAudio.Wasapi + WinMM (not the metapackage) are pure managed — single-file
         safe (WinMM is the ACM wrapper that decodes the cloud voice's MP3). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <PackageReference Include="Whisper.net" Version="1.9.1" />
    <!-- The runtime package ships its natives as loose content files that a
         single-file publish would drop next to the exe; exclude its targets
         and embed the DLLs instead — WhisperRuntime extracts and loads them. -->
    <PackageReference Include="Whisper.net.Runtime" Version="1.9.1" GeneratePathProperty="true" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgWhisper_net_Runtime)\build\win-x64\*.dll"
                      LogicalName="Palon.WhisperNative.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
